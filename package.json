    "concurrently": "^10.0.6"
    
  },
  "name": "foodapp_webapp",
  "version": "1.0.0",
  "description": "Modern ételrendelő app, amely összeköti a felhasználókat a helyi éttermekkel és futárokkal. Gyors rendelés, egyszerű fizetés.",
